Tests/*.brep
Tests/*.stl
Tests/*.step
Tests/*.stp
Tests/*.iges
Tests/*.igs

# Keep the Tests directory structure but ignore contents
!Tests/.gitkeep

# ─── Logs ────────────────────────────────
*.log
logs/

# ─── OS / Editor ─────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
*.iml

# ─── Python / FreeCAD cache (MeshPart) ───
__pycache__/
*.pyc
*.pyo

# ─── Docker ──────────────────────────────
