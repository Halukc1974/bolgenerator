# ─── Node.js ─────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.env
.env.local

# ─── C++ Build Artifacts ─────────────────
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe

# Project-specific binary
scim_bolts

# ─── CAD / Runtime Output ────────────────
